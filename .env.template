# Thesis Grok Trader — Environment Configuration
# Copy to .env:  copy .env.template .env

# ===========================================
# PAPER MODE (DEFAULT)
# ===========================================
EXECUTION_BACKEND=ibkr               # ibkr = route orders to TWS paper (7497); local_sim = offline sim only
PAPER_STARTING_CASH=100000
TRADING_MODE=paper                   # paper | aggressive_paper | live
CASH_ONLY=true

# ===========================================
# GROK / xAI (Required)
# ===========================================
GROK_API_KEY=your_grok_api_key_here
MAX_DAILY_LLM_COST=4.5

# ===========================================
# MARKET DATA (Hybrid: MarketData.app + Polygon)
# ===========================================
# MARKETDATA_TOKEN=your_marketdata_token
# Primary for quotes, candles, ATR, and MDA option-chain fallback.

# POLYGON_API_KEY=your_polygon_api_key
# Optional — preferred for delta-filtered options chains (get_options_chain).
# When set, glue/fetch_data uses Polygon for option_chain unless data_source=marketdata.

# ===========================================
# IBKR REAL-TIME STREAMS
# ===========================================
# IBKR_STREAMS=auto                  # auto | 1 | 0
# auto = enable streams when EXECUTION_BACKEND=ibkr OR TRADING_MODE=live
# IBKR_QUOTES_ENABLED=1              # explicit override (optional)
# IBKR_QUOTE_LINE_BUDGET=90          # max concurrent streaming lines
# Requires TWS/IB Gateway + your market data subscriptions (paper or live).

# ===========================================
# IBKR ORDER ROUTING (when EXECUTION_BACKEND=ibkr)
# ===========================================
IBKR_HOST=127.0.0.1
IBKR_PORT=7497                       # 7497=paper, 7496=live
IBKR_CLIENT_ID=1
IBKR_CONNECT_MAX_ATTEMPTS=12
IBKR_ACCOUNT_ID=DU1234567

# ===========================================
# OPTIONS (no extra keys — uses IBKR + MarketData.app)
# ===========================================
# Option chains: Polygon (if POLYGON_API_KEY) else MarketData.app REST
# Legacy get_option_chain() always uses MarketData.app
# Option orders: IBKR via execution/ibkr_options.py (EXECUTION_BACKEND=ibkr)
# Local sim: glue/paper_broker.py simulates option fills when EXECUTION_BACKEND=local_sim

# ===========================================
# RISK
# ===========================================
RISK_PER_TRADE=1.0
MIN_RR=2.0
MAX_DAILY_LOSS_PCT=15.0
INTRADAY_DRAWDOWN_PCT=3.0

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=INFO
