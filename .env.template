# Thesis Grok Trader — Environment Configuration
# Copy to .env and fill in:  copy .env.template .env

# ===========================================
# PAPER MODE (DEFAULT — read this first)
# ===========================================
# EXECUTION_BACKEND=local_sim   ← default: no broker, simulated fills
# EXECUTION_BACKEND=ibkr        ← route orders to TWS paper (7497) or live (7496)
EXECUTION_BACKEND=local_sim
PAPER_STARTING_CASH=100000      # local_sim starting cash (USD)
TRADING_MODE=paper              # paper | aggressive_paper | live
CASH_ONLY=true                  # long-only stock entries

# ===========================================
# GROK / xAI (Required for decisions)
# ===========================================
GROK_API_KEY=your_grok_api_key_here
# Alternative: XAI_API_KEY=your_xai_api_key_here
MAX_DAILY_LLM_COST=4.5

# ===========================================
# MARKET DATA (Recommended)
# ===========================================
# MARKETDATA_TOKEN=your_marketdata_api_key_here
# Token only — do not prefix with "Bearer ".
# Without a token, yfinance fallbacks may apply (slower / less reliable).

# ===========================================
# IBKR (Only if EXECUTION_BACKEND=ibkr)
# ===========================================
IBKR_HOST=127.0.0.1
IBKR_PORT=7497                    # 7497=paper, 7496=live
IBKR_CLIENT_ID=1
IBKR_CONNECT_MAX_ATTEMPTS=12
IBKR_ACCOUNT_ID=DU1234567         # your paper account id

# ===========================================
# RISK LIMITS (from ABC risk_execution_config)
# ===========================================
RISK_PER_TRADE=1.0                # % of account per trade (1.0 = 1%)
MIN_RR=2.0                        # minimum reward:risk before entries
MAX_DAILY_LOSS_PCT=15.0
INTRADAY_DRAWDOWN_PCT=3.0

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=INFO
